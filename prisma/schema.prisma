// Prisma Schema for Geometry Dash Web Studio
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  DEMON
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  image       String?
  stars       Int      @default(0)
  secretCoins Int      @default(0)
  createdAt   DateTime @default(now())

  levels      Level[]
  progress    Progress[]
  accounts    Account[]
  sessions    Session[]
}

model Level {
  id          String     @id @default(uuid())
  title       String
  description String?
  creatorId   String
  levelData   Json
  songUrl     String?
  songTitle   String?    @default("Neon Overdrive")
  bpm         Int        @default(140)
  difficulty  Difficulty @default(EASY)
  starsReward Int        @default(1)
  plays       Int        @default(0)
  likes       Int        @default(0)
  isVerified  Boolean    @default(false)
  createdAt   DateTime   @default(now())

  creator     User       @relation(fields: [creatorId], references: [id])
  progress    Progress[]

  @@index([creatorId])
  @@index([difficulty])
  @@index([createdAt])
}

model Progress {
  id         String   @id @default(uuid())
  userId     String
  levelId    String
  percentage Int      @default(0)
  attempts   Int      @default(0)
  bestTime   Float?
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])
  level      Level    @relation(fields: [levelId], references: [id])

  @@unique([userId, levelId])
  @@index([levelId])
  @@index([userId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
